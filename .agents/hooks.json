{
  "strata-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/pre_tool_guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
